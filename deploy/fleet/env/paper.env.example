# Copy to deploy/fleet/env/paper.env (chmod 600). Paper credentials stay here.
FLEET_CLERK_ID=
FLEET_WORKER_KEY=
FLEET_AGENT_SERVICE_TOKEN=
FLEET_COORDINATOR_SERVICE_TOKEN=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# The retained market-data session is read-only and this client id must
# differ from Live's value in live.env. Documentary only: compose.fleet.dev.yaml
# sets IBKR_CLIENT_ID under `environment:`, which always wins over this
# env_file value for the same key (Compose's own rule; the whole reason the
# four keys above are env_file-only there). 2 is the value the running
# override currently deploys with — authoritative for this PR, which
# transcribes what runs, not what was originally planned. To use a different
# id, set FLEET_PAPER_IBKR_CLIENT_ID (not this line).
IBKR_CLIENT_ID=2
# Lake catalog login for this lane (#2166): read-only fleet_lake_catalog
# role, provisioned (with this password) by
# deploy/fleet/sql/provision-fleet-lake-catalog-role.sql. Never a superuser
# URL here — compose.yaml's templated postgres login is the combined role's,
# and a clerk's database login is the blast radius of a lane compromise.
POSTGRES_URL=postgres://fleet_lake_catalog:replace-with-the-password-you-provisioned@db:5432/postgres
