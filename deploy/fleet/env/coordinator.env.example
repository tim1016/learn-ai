# Copy to deploy/fleet/env/coordinator.env (chmod 600) for a fleet deployment.
# The coordinator owns this control-plane and data-plane root. Do not put
# Alpaca execution or clerk-local IBKR credentials in this file. Polygon is
# passed from the deployment environment because coordinator owns data-plane
# market-data work.
FLEET_COORDINATOR_SERVICE_TOKENS_JSON={}
FLEET_AGENT_SERVICE_TOKENS_JSON={}
DATA_PLANE_CONTROL_SECRET=
# Complete connection strings are deployment secrets. Do not put these in a
# Compose file or derive them from a committed fallback password.
POSTGRES_URL=
REDIS_URL=
