# Polygon.io API Configuration
# Get your API key from: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://backend:8080,http://localhost:5000,http://localhost:4200

# Data Sanitization Settings
MAX_NULL_PERCENTAGE=0.1
REMOVE_DUPLICATES=true
FILL_METHOD=ffill

# Alpaca (ADR 0059, superseded in part by ADR 0060). The data plane reads THIS
# file (compose `env_file`), not the repo-root .env. Only secrets and deployment
# bootstrap belong here now — the endpoint mode and the six risk-envelope values
# are a saved broker profile, edited in the browser at
# /api/brokers/alpaca/configuration and made effective by pressing Apply and
# restarting.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
#
# RETIRED — do not re-add. ALPACA_MODE, ALPACA_LIVE_LOSS_FRACTION,
# ALPACA_LIVE_LOSS_USD, ALPACA_LIVE_SHADOW_SESSIONS,
# ALPACA_LIVE_ARMING_MAX_SESSIONS, ALPACA_LIVE_XH_ENTRY_BPS and
# ALPACA_LIVE_XH_EXIT_BPS moved into the profiles database. Once an installation
# has a saved profile the worker REFUSES TO BIND while any of them is still set,
# naming the ones to delete (ADR 0060 open question 1, owner 2026-09-10). The
# gate closes; the service still boots. To move an existing deployment across,
# run: python -m scripts.manage_broker_configuration plan --plan-out …
# (`ALPACA_MODE` stays in compose.yaml for the isolated qualification container
# only, where it is that container's paper-only proof and no profile is loaded.)
#
# Credential slots (ADR 0060 / broker-configuration-profile-contract §3). A saved
# broker profile names an opaque slot, never a variable and never a value; the
# allowlist is a closed set in code, so an unknown name is refused and never
# becomes a lookup. Two slots exist:
#   default — the pair above. Every current deployment already has it; nothing
#             changes for it and it needs no new entry here.
#   live    — a second pair, so a paper profile and a live profile can both be
#             provisioned at once and switching which one is effective does not
#             mean editing this file. Leave blank until a live profile needs it.
# ALPACA_CREDENTIAL_LIVE_KEY_ID=
# ALPACA_CREDENTIAL_LIVE_SECRET_KEY=
# A live boot refuses to install its authority behind an open control plane.
# DATA_PLANE_ALLOW_UNAUTHENTICATED_CONTROL=false
