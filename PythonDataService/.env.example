# Polygon.io API Configuration
# Get your API key from: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://backend:8080,http://localhost:5000,http://localhost:4200

# Data Sanitization Settings
MAX_NULL_PERCENTAGE=0.1
REMOVE_DUPLICATES=true
FILL_METHOD=ffill

# Alpaca (ADR 0059). The data plane reads THIS file (compose `env_file`), not the
# repo-root .env. Exactly one ALPACA_MODE line; every ALPACA_LIVE_* value is
# required when ALPACA_MODE=live and deliberately absent by default.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# ALPACA_MODE=paper
# Optional Paper-twin halt/status feed from the existing Shadow service.
# Price bars still come from IBKR; this does not add an Alpaca data subscription.
# Requires matching DATA_PLANE_CONTROL_SECRET in the two workers.
# ALPACA_MARKET_STATUS_UPSTREAM_URL=http://python-service:8000/api/brokers/alpaca/market-status-snapshot
# ALPACA_LIVE_LOSS_FRACTION=
# ALPACA_LIVE_LOSS_USD=
# ALPACA_LIVE_SHADOW_SESSIONS=
# ALPACA_LIVE_ARMING_MAX_SESSIONS=
# ALPACA_LIVE_XH_ENTRY_BPS=
# ALPACA_LIVE_XH_EXIT_BPS=
# A live boot refuses to install its authority behind an open control plane.
# DATA_PLANE_ALLOW_UNAUTHENTICATED_CONTROL=false
