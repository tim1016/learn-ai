# Polygon.io API Configuration
# Get your API key from: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key_here
ALPACA_QUALIFICATION_API_KEY_ID=qualification_paper_placeholder
ALPACA_QUALIFICATION_API_SECRET_KEY=qualification_paper_placeholder
FRED_API_KEY=your_fred_api_key_here

# Real-money Alpaca Live risk envelope — MOVED (ADR 0060). The six
# ALPACA_LIVE_* values and the runtime's endpoint mode are now a saved broker
# profile on the Clerk volume, not environment settings. This file never fed
# them to the data plane anyway (it feeds compose interpolation; the data plane
# reads PythonDataService/.env), so there is nothing to move here — see that
# file's RETIRED note for the cutover command.
#
# ALPACA_MODE below is NOT the runtime's endpoint mode. It is the interpolation
# input for the isolated `alpaca-clerk-qualification` container only, which
# asserts `test "$ALPACA_MODE" = "paper"` as its paper-only proof and loads no
# profile. It keeps the variable until an equivalent proof replaces it (ADR 0060,
# "Considered and rejected"). Leave it unset unless you run that container.
# ALPACA_MODE=paper

# Credential slots (ADR 0060 / broker-configuration-profile-contract §3). A saved
# broker profile names an opaque slot, never a variable and never a value. Two
# slots exist: "default" is the ALPACA_API_KEY_ID / ALPACA_API_SECRET_KEY pair
# the data plane already uses (PythonDataService/.env), and "live" is this second
# pair, so a paper and a live profile can be provisioned at once. Leave blank
# until a live profile needs it.
# ALPACA_CREDENTIAL_LIVE_KEY_ID=
# ALPACA_CREDENTIAL_LIVE_SECRET_KEY=

# PostgreSQL
POSTGRES_PASSWORD=mysecretpassword

# Redis backs local job state and SSE streams. Compose has a development
# fallback, but operators should set a real secret for any shared machine.
# Use URL-safe characters because compose injects this into Redis client URLs.
REDIS_PASSWORD=change-me-redis-password

# Required local data-plane control guard. Generate a distinct value with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Paste the output into DATA_PLANE_CONTROL_SECRET in your untracked .env file.
# Compose passes that same value to the Python data plane and Angular dev proxy.
DATA_PLANE_CONTROL_SECRET=

# Local-only escape hatch for intentionally open experiments. Keep false for
# normal compose and any shared machine.
DATA_PLANE_ALLOW_UNAUTHENTICATED_CONTROL=false

# LEAN Sidecar launcher URL (host process, not a compose container).
# The compose default ``http://host.containers.internal:8090`` works on
# Windows and Linux Podman via compose.yaml extra_hosts. Override only for
# non-standard runtimes — e.g. a remote launcher or a non-default port. Do
# not pin a machine-specific LAN IP. Verify reachability with
# ``GET /api/lean-sidecar/diagnose``.
# LEAN_LAUNCHER_URL=http://host.containers.internal:8090
